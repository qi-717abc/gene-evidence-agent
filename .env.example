# Copy this file to .env and replace only the values you need.
# Never commit .env or put real credentials in this example file.

# Optional external model configuration. Model calls remain disabled unless explicitly enabled.
GEA_MODEL_PROVIDER=openai_compatible
# GEA_MODEL_NAME=your-provider/model-name
# GEA_MODEL_BASE_URL=https://api.example.com/v1
# GEA_MODEL_API_KEY=replace-with-your-own-secret
GEA_MODEL_ENABLED=false
# Cancer/gene education chat is a separate explicit opt-in and ledger scope.
# GEA_WEB_EDUCATION_CHAT_ENABLED=false
# Set a local credit limit based on your provider's terms.
# GEA_MODEL_MONTHLY_BUDGET_CREDITS=
# Keep a conservative output limit when first connecting a provider.
GEA_MODEL_MAX_OUTPUT_TOKENS=4000
# Model timeout is independent from database search; maximum 1800 seconds.
GEA_MODEL_REQUEST_TIMEOUT_SECONDS=300
# Historical uncertain calls remain counted; default is fail-closed. Set a process-level
# baseline only when explicitly authorized, e.g. GEA_MODEL_ALLOWED_UNCERTAIN_REQUESTS=13.
# Any additional uncertain request above that baseline freezes later calls.
GEA_MODEL_ALLOWED_UNCERTAIN_REQUESTS=0
# Optional and applies only to Chinese localization; set only after provider confirmation.
# GEA_CHINESE_THINKING_MODE=disabled
# Set credit prices and context window only after checking your provider's terms.
# GEA_MODEL_INPUT_PRICE_CREDITS_PER_MILLION_TOKENS=
# GEA_MODEL_OUTPUT_PRICE_CREDITS_PER_MILLION_TOKENS=
# GEA_MODEL_CONTEXT_WINDOW_TOKENS=
GEA_MODEL_USAGE_DB_PATH=.gene-evidence-agent/model_usage.sqlite3
GEA_AGENT_RUN_TIMEOUT_SECONDS=900

# NCBI E-utilities identity for PubMed requests.
# Required for live requests: use the software developer's contact email, not an end user's.
# GEA_NCBI_EMAIL=you@example.org
# Optional; usually not needed at low request rates.
# GEA_NCBI_API_KEY=replace-with-your-own-secret

# Bounded external request defaults.
GEA_REQUEST_TIMEOUT_SECONDS=60
GEA_MAX_RESULTS_PER_SOURCE=10
GEA_CACHE_TTL_SECONDS=900
GEA_LOG_LEVEL=INFO

GEA_MODEL_FREEZE_ON_UNCERTAIN_USAGE=false
# Web defaults to extractive: cite complete sentences from validated translations.
# Set this process environment variable to model to retain legacy model-written claims.
GEA_CHINESE_CLAIMS_MODE=extractive
# Extractive localization translates records separately; 10 selects legacy batching.
# Exact adapter-generated drug metadata is translated locally and labeled non-model.
GEA_CHINESE_TRANSLATION_BATCH_SIZE=1
